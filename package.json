{
  "name": "flightline-golf-tracer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "python3 -m http.server 5173 --bind 127.0.0.1 --directory dist",
    "eval:tracking": "node tests/evaluate-tracking.mjs --manifest tests/fixtures/local-manifest.json",
    "eval:tracking:legacy": "node tests/evaluate-tracking.mjs --manifest tests/fixtures/local-manifest.json --engine legacy",
    "eval:compare": "node tests/compare-results.mjs",
    "eval:contact-sheet": "node tests/contact-sheet.mjs",
    "eval:manifest": "node tests/build-manifest.mjs"
  }
}
