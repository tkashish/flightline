{
  "schema": "flightline-bench-acceptance-v1",
  "source": "FINAL.md 'Acceptance gate' (SAFETY all must pass before the default flips to hf; QUALITY is reported) and D3 sec. 9.4-9.5. Threshold values live in dist/hf/params.js PARAMS.acceptance; each target names its param path and repeats the value, and tests/hf-bench-metrics.test.js fails when they drift apart.",
  "paramsVersion": "hf-params-1",
  "targets": [
    { "id": "wrongGivenTraced", "tier": "safety", "metric": "safety.wrongGivenTraced", "op": "le", "param": "safety.maxWrongGivenTraced", "value": 0.01, "unit": "frac of traced clips", "text": "P(wrong | traced) <= 1.0% (wrong: not the ball's flight, or a visible predicted arc more than 5% of the diagonal off)" },
    { "id": "clubFalseTrack", "tier": "safety", "metric": "safety.clubFalseTrack", "op": "le", "param": "safety.maxClubFalseTrack", "value": 0.005, "unit": "frac of clips with an impact", "text": "Club-head false-track rate <= 0.5% of clips" },
    { "id": "noBallFalseTrace", "tier": "safety", "metric": "safety.noBallFalseTrace", "op": "le", "param": "safety.maxNoBallFalseTrace", "value": 0.01, "unit": "frac of no-ball clips", "text": "No-ball (practice swing, whiff) false trace <= 1%" },
    { "id": "invisibleAbstain", "tier": "safety", "metric": "safety.invisibleAbstain", "op": "ge", "param": "safety.minInvisibleAbstain", "value": 0.98, "unit": "frac of invisible-ball controls", "text": "Invisible-ball-in-flight control abstention >= 98%" },
    { "id": "coverageDtl", "tier": "quality", "metric": "quality.coverage.dtl", "op": "ge", "param": "quality.coverageDtl", "value": 0.95, "unit": "frac of trace clips", "text": "Coverage, down-the-line, ball visible >= 0.3 s real" },
    { "id": "coverageFoFast", "tier": "quality", "metric": "quality.coverage.foFast", "op": "ge", "param": "quality.coverageFoFast", "value": 0.9, "unit": "frac of trace clips", "text": "Coverage, face-on 120/240 fps capture and slow motion" },
    { "id": "coverageFoRealtime", "tier": "quality", "metric": "quality.coverage.foRealtime", "op": "ge", "param": "quality.coverageFoRealtime", "value": 0.6, "unit": "frac of trace clips", "text": "Coverage, face-on 30/60 fps (physically limited)" },
    { "id": "launchFrame", "tier": "quality", "metric": "quality.launchFrame", "op": "ge", "param": "quality.launchFrameFrac", "value": 0.97, "unit": "frac of traced clips", "text": "Launch timing |dt| <= 1 frame" },
    { "id": "launchPoint", "tier": "quality", "metric": "quality.launchPoint", "op": "ge", "param": "quality.launchPointFrac", "value": 0.97, "unit": "frac of traced clips", "text": "Launch point <= 0.5 d0 (d0 from quality.launchPointD0)" },
    { "id": "identityMatched", "tier": "quality", "metric": "quality.identityMatched", "op": "ge", "param": "quality.identityMatched", "value": 0.995, "unit": "frac of observed points", "text": "Identity: observed points matched" },
    { "id": "identitySwitch", "tier": "quality", "metric": "quality.identitySwitch", "op": "le", "param": "quality.maxIdentitySwitch", "value": 0.005, "unit": "frac of traced clips", "text": "Identity switches" },
    { "id": "recallSnr6", "tier": "quality", "metric": "quality.recall.0", "op": "ge", "param": "quality.recallBySnr.0.1", "value": 0.97, "unit": "frac of GT-visible frames", "text": "Observed recall, SNR >= 6" },
    { "id": "recallSnr3", "tier": "quality", "metric": "quality.recall.1", "op": "ge", "param": "quality.recallBySnr.1.1", "value": 0.85, "unit": "frac of GT-visible frames", "text": "Observed recall, SNR 3-6" },
    { "id": "recallSnr2", "tier": "quality", "metric": "quality.recall.2", "op": "ge", "param": "quality.recallBySnr.2.1", "value": 0.5, "unit": "frac of GT-visible frames", "text": "Observed recall, SNR 2-3" },
    { "id": "posMedian", "tier": "quality", "metric": "quality.position.large.median", "op": "le", "param": "quality.posMedianD", "value": 0.35, "unit": "d", "text": "Position error median <= 0.35 d (balls >= 2 px)" },
    { "id": "posMedianSmall", "tier": "quality", "metric": "quality.position.small.median", "op": "le", "param": "quality.posMedianSmallPx", "value": 0.6, "unit": "px", "text": "Position error median <= 0.6 px (balls < 2 px)" },
    { "id": "posP95", "tier": "quality", "metric": "quality.position.large.p95", "op": "le", "param": "quality.posP95D", "value": 1, "unit": "d", "text": "Position error p95 <= 1.0 d (balls >= 2 px)" },
    { "id": "posP95Small", "tier": "quality", "metric": "quality.position.small.p95", "op": "le", "param": "quality.posP95SmallPx", "value": 1.5, "unit": "px", "text": "Position error p95 <= 1.5 px (balls < 2 px)" },
    { "id": "completionLongMedian", "tier": "quality", "metric": "quality.completion.long.median", "op": "le", "param": "quality.completionLongMedianDiag", "value": 0.02, "unit": "frac of diag", "text": "Completion shape error median, >= 30% of flight observed" },
    { "id": "completionLongP90", "tier": "quality", "metric": "quality.completion.long.p90", "op": "le", "param": "quality.completionLongP90Diag", "value": 0.05, "unit": "frac of diag", "text": "Completion shape error p90, >= 30% of flight observed" },
    { "id": "completionShortMedian", "tier": "quality", "metric": "quality.completion.short.median", "op": "le", "param": "quality.completionShortMedianDiag", "value": 0.035, "unit": "frac of diag", "text": "Completion shape error median, < 30% observed" },
    { "id": "completionShortP90", "tier": "quality", "metric": "quality.completion.short.p90", "op": "le", "param": "quality.completionShortP90Diag", "value": 0.08, "unit": "frac of diag", "text": "Completion shape error p90, < 30% observed" },
    { "id": "landingTime", "tier": "quality", "metric": "quality.completion.landingTime.median", "op": "le", "param": "quality.landingTimeMedian", "value": 0.08, "unit": "frac of flight time", "text": "Landing-time error median" },
    { "id": "ece", "tier": "quality", "metric": "quality.calibration.ece", "op": "le", "param": "quality.maxEce", "value": 0.05, "unit": "frac", "text": "Calibration ECE of confidence.value vs trace correct" },
    { "id": "runtime4k60", "tier": "quality", "source": "browser", "metric": "quality.runtime.k4k60", "op": "le", "param": "quality.runtime4k60Sec", "value": 20, "unit": "s per 10 s clip", "text": "Runtime, 10 s 4K60 (laptop Chrome, codec path)" },
    { "id": "runtime1080p30", "tier": "quality", "source": "browser", "metric": "quality.runtime.p1080p30", "op": "le", "param": "quality.runtime1080p30Sec", "value": 10, "unit": "s per 10 s clip", "text": "Runtime, 10 s 1080p30" },
    { "id": "workerHeap", "tier": "quality", "source": "browser", "metric": "quality.memory.workerHeapMb", "op": "le", "param": "quality.workerHeapMb", "value": 150, "unit": "MB", "text": "Worker heap peak" },
    { "id": "tabRss", "tier": "quality", "source": "browser", "metric": "quality.memory.tabRssMb", "op": "le", "param": "quality.tabRssMb", "value": 400, "unit": "MB", "text": "Tab RSS increase" },
    { "id": "parityDecision", "tier": "quality", "source": "parity", "metric": "decision", "op": "ge", "param": "quality.parityDecision", "value": 0.98, "unit": "frac of clips", "text": "Node/browser decision agreement" },
    { "id": "parityLaunchFrame", "tier": "quality", "source": "parity", "metric": "launchFrame", "op": "ge", "param": "quality.parityLaunchFrame", "value": 0.97, "unit": "frac of clips with a launch", "text": "Node/browser launch frame agreement" },
    { "id": "parityPosition", "tier": "quality", "source": "parity", "metric": "positionPx", "op": "le", "param": "quality.parityMedianPx", "value": 0.3, "unit": "px", "text": "Node/browser median observed-position delta" }
  ],
  "definitions": {
    "smallBallPx": 2,
    "snrUncodedScale": 0.6,
    "snrNote": "A frame's SNR is the generator's decoded-video oracle ball.snrCoded, else 0.6 x ball.expectedSnr (the generator's own visibility convention, D2 sec. 9.3 oracle).",
    "wrong": {
      "includeCompletion": true,
      "completionDiag": 0.05,
      "launchFrames": 3,
      "launchRealSec": 0.25,
      "launchD0": 2,
      "minMatchedFrac": 0.5,
      "switchRun": 3,
      "stealHits": 3,
      "note": "A traced clip is wrong when the clip has no ball flight, the club or a distractor was tracked, an identity switch happened, fewer than half the observed points are the ball, the launch is off by more than max(3 frames, 0.25 s real: another event, while v2's 0.2 s early seeds stay right) or 2 d0, or (includeCompletion) a visible predicted point is more than completionDiag x diag from the true arc, matched in order along it (metrics.mjs arcAlign: a down-the-line descent lies over the ascent, so the nearest point anywhere would hide a landing overshoot). completionDiag equals PARAMS.confidence.labelShapeErrDiag, the confidence training label."
    },
    "completionMinAlpha": 0.5,
    "dtlMinVisibleRealSec": 0.3,
    "foFastMinCaptureFps": 120,
    "noBallKinds": ["practice", "practice-noball", "whiff"],
    "invisibleMarkers": ["invisible", "hideball", "hiddenball", "ballhidden"],
    "eceBins": 10,
    "bootstrap": { "n": 200, "seed": 1 },
    "runtimeFormats": {
      "k4k60": { "longEdge": 3840, "fps": 60, "clipSec": 10 },
      "p1080p30": { "longEdge": 1920, "fps": 30, "clipSec": 10 }
    },
    "strata": ["set", "viewClass", "capture", "format", "sky", "expected", "kind", "control", "styleShift", "codec", "snrBin", "failureModes"],
    "sets": "set: the clip's split when it is 'controls' (invisible-ball controls) or 'perf' (perf set, D3 sec. 9.2), else 'main'. Perf clips count for runtime, memory and run errors only; a runtime target uses perf clips of its format and length when present, else a projection from ms/frame."
  }
}
